# Ollama normally listens here when `ollama serve` is running.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Keep this on loopback and connect with SSH port forwarding whenever possible.
APP_HOST=127.0.0.1
APP_PORT=9955

# Optional shared secret. Required if APP_HOST is exposed beyond loopback.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OLLAMA_WEB_TOKEN=

# Upload and extracted-text safety limits.
MAX_UPLOAD_MB=25
MAX_DOCUMENT_CHARS=200000
